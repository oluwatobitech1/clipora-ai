# LOCAL MODE (npm run dev) needs NO values here. Transcribe is free and runs on your computer.
# Optional: OPENAI_API_KEY switches Transcribe to OpenAI (faster, billed by OpenAI).
# Optional: TRANSCRIBE_ENGINE=local|openai   LOCAL_WHISPER_MODEL=Xenova/whisper-base (try whisper-tiny for speed, whisper-small for accuracy)
# Clipora AI: copy this file to ".env" (same folder) and fill in the 4 values below. Never share or commit ".env".
# Everything else has a safe default in the code.

# Supabase: Settings > Data API (Project URL)
SUPABASE_URL=PASTE_PROJECT_URL
VITE_SUPABASE_URL=PASTE_PROJECT_URL

# Supabase: Settings > API Keys
# Publishable key (sb_publishable_...). Public by design.
VITE_SUPABASE_ANON_KEY=PASTE_PUBLISHABLE_KEY
# Secret key (sb_secret_...). SERVER ONLY. Never paste it into chat, screenshots or website code.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SECRET_KEY

# ----- Optional (defaults shown) -----
# MAX_UPLOAD_MB=50              Free Supabase plan cannot exceed 50
# RETENTION_HOURS=24
# MAX_MEDIA_DURATION_MINUTES=60
# MAX_JOBS_PER_DAY=20
# MAX_UPLOADS_PER_DAY=40
# MAX_ACTIVE_JOBS_PER_USER=2
# CORS_ORIGIN=http://localhost:5173   (set to your website address when online)
# VITE_API_URL=                       (empty locally; the API's public address when online)
# OPENAI_API_KEY=                     (needed only for Transcribe. Server side only: never put it in a VITE_ variable)
# TRANSCRIBE_MODEL=whisper-1          (must return timestamps for SRT/VTT; whisper-1 does)
# TRANSCRIBE_CHUNK_SECONDS=600        (audio is cut into pieces this long; keeps each request far under the 25 MB limit)
# OPENAI_BASE_URL=                    (only for an OpenAI-compatible server; default https://api.openai.com)
# LOCAL_MAX_UPLOAD_MB=500            (local mode only)
