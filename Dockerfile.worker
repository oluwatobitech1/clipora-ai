# Build from the repo root:  docker build -f Dockerfile.worker -t framevox-worker .
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/worker/package.json apps/worker/
RUN npm install --workspace @framevox/worker --workspace @framevox/shared --include-workspace-root
COPY packages/shared packages/shared
COPY apps/worker apps/worker
USER node
# Configuration comes from the host's environment variables (see .env.example), not from a file.
CMD ["npx", "tsx", "apps/worker/src/index.ts"]
