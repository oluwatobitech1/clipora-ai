{
  "name": "framevox",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @framevox/web",
    "dev:web": "npm run dev -w @framevox/web",
    "dev:api": "npm run dev -w @framevox/api",
    "dev:worker": "npm run dev -w @framevox/worker",
    "build": "npm run build -w @framevox/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:local": "npm run dev -w @framevox/web",
    "dev:local-api": "npm run dev -w @framevox/local",
    "dev:cloud": "concurrently -k -n api,worker,web -c blue,green,magenta \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "start": "npm run dev -w @framevox/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
