# Hosted link server (YouTube/TikTok/Instagram/X/Facebook link import). Build from the repo root:
#   docker build -f Dockerfile.link -t framevox-links .
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates python3 \
  && mkdir -p /opt/ytdlp \
  && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /opt/ytdlp/yt-dlp \
  && chmod a+rx /opt/ytdlp/yt-dlp && chown -R node:node /opt/ytdlp && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/local/package.json apps/local/
COPY apps/worker/package.json apps/worker/
RUN npm install --workspace @framevox/local --workspace @framevox/shared --include-workspace-root
COPY packages/shared packages/shared
COPY apps/local apps/local
COPY apps/worker apps/worker
USER node
ENV LINK_SERVER=1 PORT=10000 HOME=/tmp YTDLP_PATH=/opt/ytdlp/yt-dlp
EXPOSE 10000
# Sites change often, so update yt-dlp every time the server starts.
CMD ["sh", "-c", "/opt/ytdlp/yt-dlp -U >/dev/null 2>&1 || true; exec npx tsx apps/local/src/index.ts"]
